# Copy this file to .env and fill in your values. Never commit .env.

# Optional: use Ollama's hosted cloud API instead of (or as fallback to) local Ollama.
# Get a key at https://ollama.com/settings/keys (free tier available).
OLLAMA_API_KEY=

# Optional: model names. Cloud catalog may use different tags than local.
# LLM_MODEL=qwen3:1.7b
# LLM_CLOUD_MODEL=gpt-oss:20b

# Fact-checking is fully autonomous: combines curated Indian health myth corpus (LaBSE)
# with real-time web verification across certified fact-checkers & health authorities.
# No API keys or Google Cloud setup required ($0 cost).
